
# CivicPulse Backend Environment Variables
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL / Supabase
DB_HOST=your_supabase_pooler_host
DB_PORT=5432
DB_NAME=postgres
DB_USER=your_supabase_database_user
DB_PASSWORD=
DB_SSL=true

# JWT
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=24h

# Email / SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login
SMTP_PASSWORD=
SMTP_FROM_EMAIL=your_verified_sender_email

# Optional Python Analytics Service
PYTHON_SERVICE_URL=
PYTHON_SERVICE_TOKEN=replace_with_a_random_internal_service_token

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
