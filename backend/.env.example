# CivicPulse Backend Environment Variables
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MySQL / XAMPP Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=civicpulse_db
DB_USER=your_mysql_username
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=24h

# Email / SMTP Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Optional Python Analytics Service Integration
PYTHON_SERVICE_URL=http://127.0.0.1:8000
PYTHON_SERVICE_TOKEN=replace_with_the_same_random_internal_service_token

# Uploads Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=5
